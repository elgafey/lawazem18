<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Custom Invoice Design - Main Entry Point
         Uses docs variable (standard Odoo report rendering context)

         All styling lives in static/src/scss/invoice_report.scss, registered
         under 'web.report_assets_common' in __manifest__.py (no inline
         <style> block here anymore).
    ====================================================================== -->
    <template id="invoice_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Odoo 18 can only render with an *active* language. Fall back
                     to the user language when the partner language is not
                     installed (e.g. `ar_001` data coming from Odoo 20). -->
                <t t-set="installed_langs"
                   t-value="[code for code, name in env['res.lang'].get_installed()]"/>
                <t t-set="lang"
                   t-value="o.partner_id.lang if o.partner_id.lang in installed_langs else (env.user.lang if env.user.lang in installed_langs else 'en_US')"/>
                <t t-call="custom_invoice_design.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- =====================================================================
         Main Invoice Document
    ====================================================================== -->
    <template id="report_invoice_document">
        <t t-set="o"       t-value="o.with_context(lang=lang)"/>
        <t t-set="company" t-value="o.company_id"/>

        <!-- ============ PAYMENTS RECONCILED WITH THIS INVOICE ============
             A payment is printed only when it is really reconciled on this
             invoice (account.move.reconciled_payment_ids): one row per
             payment.
               pmt_count : number of payments -> that many detail rows
             No payment -> no detail row, so the layout never jumps. -->
        <t t-set="inv_pmts"
           t-value="(o.reconciled_payment_ids.sorted('date') if 'reconciled_payment_ids' in o._fields else o.env['account.payment'])"/>
        <t t-set="pmt_count" t-value="len(inv_pmts)"/>

        <!-- ============ DYNAMIC FIT SCALE (with the rows) ============
             row_weight ≈ how many visual lines the invoice will take:
             +1 per section / note row, +1 extra for every ~40 characters of
             the item name (the name column holds ~38 chars), +1 per payment
             row.
             font_pt follows row_weight CONTINUOUSLY (not in steps):
                few rows   -> 10.6pt (bigger, airier text)
                 average    -> ~10.4pt
                many rows  -> shrinks only down to a readable floor of 9.7pt
             Below the floor the invoice continues on the next page (rows
             never split and the table header repeats) instead of shrinking
             further, so a long invoice stays readable.
             Every font size in the stylesheet is relative (em) to this base,
             so the whole document scales together. fit-a/fit-b/fit-c/fit-d
             only tighten the spacing for long invoices.
              Knobs: 10.6 (start size), 9.7 (readable floor), 0.032 (how fast
             the size drops with the row count). -->
        <t t-set="row_weight" t-value="sum(
            1 + len(((l.product_id.name if l.product_id else l.name) or '')[:120]) // 40
            if l.display_type == 'product' else 1
            for l in o.invoice_line_ids) + pmt_count"/>
        <t t-set="font_pt" t-value="max(9.7, 10.6 - max(0, row_weight - 8) * 0.032)"/>
        <t t-set="fit_class"
           t-value="'fit-a' if row_weight &lt;= 10 else ('fit-b' if row_weight &lt;= 17 else ('fit-c' if row_weight &lt;= 25 else 'fit-d'))"/>

        <div t-att-class="'article invoice-container ' + fit_class"
             t-attf-style="font-size: {{ '%.2f' % font_pt }}pt"
             t-att-data-oe-model="o._name"
             t-att-data-oe-id="o.id">

            <!-- =================== HEADER =================== -->
            <!-- Left: logo.  Right: company identity (no contact box). -->
            <table class="tbl-header">
                <tr>
                    <td class="hdr-logo">
                        <t t-if="company and company.logo">
                            <img t-att-src="image_data_uri(company.logo)" class="co-logo" alt="Logo"/>
                        </t>
                    </td>

                    <td class="hdr-company">
                        <div class="co-name" dir="auto"><t t-out="company.name if company else ''"/></div>
                        <div class="co-meta">
                            VAT No. / <span class="ar" dir="rtl">الرقم الضريبي</span>:
                            <b><t t-out="(company and company.vat) or '-'"/></b>
                            <span class="co-meta-sep">|</span>
                            CR No. / <span class="ar" dir="rtl">السجل التجاري</span>:
                            <b><t t-out="(company.partner_id.company_registry if company and 'company_registry' in company.partner_id._fields and company.partner_id.company_registry else (company.partner_id.commercial_register if company and 'commercial_register' in company.partner_id._fields and company.partner_id.commercial_register else '-'))"/></b>
                        </div>
                        <div class="co-meta">
                            <t t-out="', '.join([x for x in [company.street, company.city, company.country_id and company.country_id.name] if x]) if company else ''"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- =================== TITLE BAND =================== -->
            <!-- ZATCA: a buyer without a VAT number gets a Simplified Tax Invoice. -->
            <t t-set="buyer_vat" t-value="(o.partner_id.vat or '').strip()"/>
            <div class="title-band">
                <table class="title-band-tbl">
                    <tr>
                        <td class="title-band-main">
                            <div class="inv-title">
                                <t t-if="o.move_type == 'out_refund'">CREDIT NOTE / <span class="ar" dir="rtl">إشعار دائن</span></t>
                                <t t-elif="o.move_type == 'in_refund'">DEBIT NOTE / <span class="ar" dir="rtl">إشعار مدين</span></t>
                                <t t-elif="not buyer_vat">SIMPLIFIED TAX INVOICE / <span class="ar" dir="rtl">فاتورة ضريبية مبسطة</span></t>
                                <t t-else="">TAX INVOICE / <span class="ar" dir="rtl">فاتورة ضريبية</span></t>
                            </div>
                        </td>
                        <td class="title-band-meta">
                            <table class="chips">
                                <tr>
                                    <td><span class="chip">Invoice No. <t t-out="o.name or '/'"/></span></td>
                                </tr>
                                <tr>
                                    <td><span class="chip">Date <t t-out="o.invoice_date or ''"/></span></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- =================== INFO CARDS (Buyer + Invoice) =================== -->
            <table class="tbl-cards">
                <tr>
                    <!-- Buyer Details -->
                    <td class="col-card">
                        <div class="info-card">
                            <div class="card-title">Buyer Details / <span class="ar" dir="rtl">بيانات المشتري</span></div>
                            <table class="tbl-detail">
                                <tr>
                                    <td class="lbl-en">Customer Name</td>
                                    <td class="val"><t t-out="o.partner_id.name if o.partner_id else ''"/></td>
                                    <td class="lbl-ar" dir="rtl">اسم العميل</td>
                                </tr>
                                <tr>
                                    <td class="lbl-en">VAT No.</td>
                                    <td class="val"><t t-out="(o.partner_id and o.partner_id.vat) or ''"/></td>
                                    <td class="lbl-ar" dir="rtl">الرقم الضريبي</td>
                                </tr>
                                <tr>
                                    <td class="lbl-en">Address</td>
                                    <td class="val">
                                        <t t-if="o.partner_id">
                                            <t t-out="', '.join([x for x in [o.partner_id.street, o.partner_id.city, o.partner_id.country_id and o.partner_id.country_id.name] if x])"/>
                                        </t>
                                    </td>
                                    <td class="lbl-ar" dir="rtl">العنوان</td>
                                </tr>
                            </table>
                        </div>
                    </td>

                    <td class="col-gap"></td>

                    <!-- Invoice Details -->
                    <td class="col-card">
                        <div class="info-card">
                            <div class="card-title">Invoice Details / <span class="ar" dir="rtl">تفاصيل الفاتورة</span></div>
                            <!-- Source Document comes from the sales order(s) linked to this
                                 invoice (sale.order.origin), NOT from the invoice's own
                                 origin. sale_line_ids exists only when the sale module is
                                 installed; the guard keeps the report renderable without it. -->
                            <t t-set="so_orders"
                               t-value="o.invoice_line_ids.sale_line_ids.order_id if 'sale_line_ids' in o.invoice_line_ids._fields else False"/>
                            <t t-set="source_doc"
                               t-value="' / '.join([x for x in so_orders.mapped('origin') if x]) if so_orders else ''"/>
                            <table class="tbl-detail">
                                    <tr>
                                        <td class="lbl-en">Invoice No.</td>
                                        <td class="val"><t t-out="o.name or '/'"/></td>
                                        <td class="lbl-ar" dir="rtl">رقم الفاتورة</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl-en">Invoice Date</td>
                                        <td class="val"><t t-out="o.invoice_date or ''"/></td>
                                        <td class="lbl-ar" dir="rtl">تاريخ الفاتورة</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl-en">Due Date</td>
                                        <td class="val"><t t-out="o.invoice_date_due or '-'"/></td>
                                        <td class="lbl-ar" dir="rtl">تاريخ الاستحقاق</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl-en">Payment Terms</td>
                                        <td class="val"><t t-out="o.invoice_payment_term_id and o.invoice_payment_term_id.name or '-'"/></td>
                                        <td class="lbl-ar" dir="rtl">شروط الدفع</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl-en">Source Document</td>
                                        <td class="val"><t t-out="source_doc or '-'"/></td>
                                        <td class="lbl-ar" dir="rtl">المستند المصدر</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl-en">Salesman</td>
                                        <td class="val"><t t-out="o.invoice_user_id and o.invoice_user_id.name or ''"/></td>
                                        <td class="lbl-ar" dir="rtl">مندوب المبيعات</td>
                                    </tr>
                                    <tr>
                                        <!-- Company tax number (was: Currency, which is already
                                             in every column header and in the totals) -->
                                        <td class="lbl-en">Company VAT No.</td>
                                        <td class="val"><t t-out="(company and company.vat) or '-'"/></td>
                                        <td class="lbl-ar" dir="rtl">الرقم الضريبي للشركة</td>
                                    </tr>
                                </table>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- =================== INVOICE LINES TABLE =================== -->
            <table class="tbl-lines">
                <thead>
                    <tr>
                        <th class="c-seq">
                            <span class="th-en">#</span>
                            <span class="th-ar">م</span>
                        </th>
                        <th class="c-code">
                            <span class="th-en">Item Code / Barcode</span>
                            <span class="th-ar">رمز الصنف / الباركود</span>
                        </th>
                        <th class="c-desc">
                            <span class="th-en">Item Name</span>
                            <span class="th-ar">اسم الصنف</span>
                        </th>
                        <th class="c-qty">
                            <span class="th-en">Qty</span>
                            <span class="th-ar">الكمية</span>
                        </th>
                        <th class="c-uprc">
                            <span class="th-en">Unit Price</span>
                            <span class="th-ar">سعر الوحدة</span>
                        </th>
                        <th class="c-vatp">
                            <span class="th-en">VAT %</span>
                            <span class="th-ar">نسبة VAT</span>
                        </th>
                        <th class="c-vatv">
                            <span class="th-en">VAT</span>
                            <span class="th-ar">قيمة VAT</span>
                        </th>
                        <th class="c-tot">
                            <span class="th-en">Total</span>
                            <span class="th-ar">الإجمالي</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="seq" t-value="0"/>
                    <t t-foreach="o.invoice_line_ids" t-as="line">
                        <!-- Section header row -->
                        <t t-if="line.display_type == 'line_section'">
                            <tr class="row-section">
                                <td colspan="8"><t t-out="line.name"/></td>
                            </tr>
                        </t>
                        <!-- Note row -->
                        <t t-elif="line.display_type == 'line_note'">
                            <tr class="row-note">
                                <td colspan="8"><t t-out="line.name"/></td>
                            </tr>
                        </t>
                        <!-- Normal product line -->
                        <t t-else="">
                            <t t-set="seq" t-value="seq + 1"/>
                            <tr>
                                <td class="c-seq"><t t-out="seq"/></td>
                                <td class="c-code">
                                    <!-- Barcode of the product (fallback: internal reference) -->
                                    <t t-out="line.product_id and (line.product_id.barcode or line.product_id.default_code or '') or ''"/>
                                </td>
                                <td class="c-desc">
                                    <!-- Product name instead of the raw line description -->
                                    <t t-if="line.product_id" t-out="line.product_id.name or line.name or ''"/>
                                    <t t-else="" t-out="line.name or ''"/>
                                </td>
                                <td class="c-qty"><t t-out="'{:g}'.format(line.quantity or 0)"/></td>
                                <td class="c-uprc">
                                    <t t-out="line.price_unit or 0.0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="c-vatp">
                                    <t t-set="line_tax_rate" t-value="sum(line.tax_ids.mapped('amount'))"/>
                                    <t t-out="'{:g}%'.format(line_tax_rate)"/>
                                </td>
                                <td class="c-vatv">
                                    <!-- Actual tax amount of the line (after discount), tax_totals style -->
                                    <t t-set="line_tax_val" t-value="(line.price_total or 0.0) - (line.price_subtotal or 0.0)"/>
                                    <t t-out="line_tax_val" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="c-tot">
                                    <t t-out="line.price_subtotal or 0.0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- =================== BOTTOM: ZATCA QR | TOTALS =================== -->
            <!-- Both columns are table cells of the same row, so they always end
                 up the same height: no empty gap next to the taller one. -->
            <table class="tbl-bottom">
                <tr>
                    <!-- Left: ZATCA QR card -->
                    <td class="qr-card">
                        <div class="qr-cap">ZATCA QR</div>
                        <t t-set="qr_val" t-value="False"/>
                        <!-- Odoo 18: ZATCA Phase 1 QR lives in l10n_sa_qr_code_str (base64 TLV).
                             Legacy/other localization field names are kept as fallbacks. -->
                        <t t-if="'l10n_sa_qr_code_str' in o._fields and o.l10n_sa_qr_code_str">
                            <t t-set="qr_val" t-value="o.l10n_sa_qr_code_str"/>
                        </t>
                        <t t-elif="'l10n_gcc_invoice_qr' in o._fields and o.l10n_gcc_invoice_qr">
                            <t t-set="qr_val" t-value="o.l10n_gcc_invoice_qr"/>
                        </t>
                        <t t-elif="'l10n_sa_qr_code' in o._fields and o.l10n_sa_qr_code">
                            <t t-set="qr_val" t-value="o.l10n_sa_qr_code"/>
                        </t>
                        <t t-if="qr_val and str(qr_val).startswith('data:image')">
                            <img t-att-src="qr_val" class="qr-img" alt="QR"/>
                        </t>
                        <t t-elif="qr_val and str(qr_val).startswith('iVBOR')">
                            <img t-attf-src="data:image/png;base64,{{qr_val}}" class="qr-img" alt="QR"/>
                        </t>
                        <t t-else="">
                            <!-- Same payload, only a larger raster so the 3.2cm display stays crisp:
                                 quote_plus(): the ZATCA payload is base64 and may contain '+' and '/'
                                 which must not be decoded as spaces by the barcode controller. -->
                            <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=240&amp;height=240' % quote_plus(str(qr_val or o.name or 'INV'))" class="qr-img" alt="QR"/>
                        </t>
                    </td>

                    <td class="col-gap"></td>

                    <!-- Right: totals card -->
                    <td class="totals-card">
                        <table class="tbl-totals">
                                <!-- Subtotal (untaxed) -->
                                <tr>
                                    <td class="tot-lbl">
                                        Subtotal / <span class="ar" dir="rtl">المجموع الفرعي</span>
                                    </td>
                                    <td class="tot-val">
                                        <t t-out="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <!-- Discount -->
                                <t t-set="disc" t-value="sum(
                                    (l.price_unit * l.quantity) * (l.discount or 0) / 100.0
                                    for l in o.invoice_line_ids
                                    if l.display_type not in ('line_section', 'line_note')
                                )"/>
                                <tr>
                                    <td class="tot-lbl">
                                        Discount / <span class="ar" dir="rtl">الخصم</span>
                                    </td>
                                    <td class="tot-val tot-discount">
                                        <t t-out="disc" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <!-- Tax rows: Odoo 18 tax_totals = {subtotals: [{name, tax_groups: [{id, group_name,
                                     tax_amount_currency, ...}]}]} (the old groups_by_subtotal / tax_group_rate keys
                                     do not exist anymore, so the rate is resolved from the invoice lines). -->
                                <t t-if="o.tax_totals and o.tax_totals.get('subtotals')">
                                    <t t-set="tax_rates" t-value="{}"/>
                                    <t t-foreach="o.invoice_line_ids" t-as="rate_line">
                                        <t t-if="rate_line.display_type == 'product'">
                                            <t t-foreach="rate_line.tax_ids" t-as="rate_tax">
                                                <t t-if="rate_tax.tax_group_id"
                                                   t-set="tax_rates"
                                                   t-value="{**tax_rates, rate_tax.tax_group_id.id: rate_tax.amount}"/>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="sub">
                                        <t t-foreach="sub.get('tax_groups', [])" t-as="grp">
                                            <t t-set="grp_rate" t-value="tax_rates.get(grp.get('id'))"/>
                                            <t t-set="grp_rate_s" t-value="'{:g}%'.format(grp_rate) if grp_rate is not None else ''"/>
                                            <t t-set="grp_name" t-value="grp.get('group_name') or 'VAT'"/>
                                            <tr>
                                                <td class="tot-lbl">
                                                    <t t-out="grp_name"/>
                                                    <t t-if="grp_rate_s and grp_rate_s not in str(grp_name)"> (<t t-out="grp_rate_s"/>)</t>
                                                    / <span class="ar" dir="rtl">ضريبة القيمة المضافة</span>
                                                </td>
                                                <td class="tot-val">
                                                    <t t-out="grp.get('tax_amount_currency') or 0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td class="tot-lbl">VAT / <span class="ar" dir="rtl">ضريبة القيمة المضافة</span></td>
                                        <td class="tot-val">
                                            <t t-out="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <!-- Total VAT is NOT repeated here: the tax_groups rows above already
                                     show every VAT amount (and the fallback row shows it when
                                     tax_totals is unavailable). -->
                                <!-- Grand Total -->
                                <tr class="row-grand">
                                    <td class="tot-lbl">
                                        Total Amount (<t t-out="o.currency_id and o.currency_id.name or 'SAR'"/>)
                                        / <span class="ar" dir="rtl">المبلغ الإجمالي</span>
                                    </td>
                                    <td class="tot-val">
                                        <t t-out="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <!-- Payments reconciled on this invoice: one row each,
                                     right under Total Amount. -->
                                <t t-set="pmt_no" t-value="0"/>
                                <t t-foreach="inv_pmts" t-as="pmt">
                                    <t t-set="pmt_no" t-value="pmt_no + 1"/>
                                    <tr class="row-payment">
                                        <td class="tot-lbl">
                                            Payment <t t-out="pmt_no"/>
                                            <t t-if="pmt.journal_id"> — <t t-out="pmt.journal_id.name"/></t>
                                            / <span class="ar" dir="rtl">الدفعة <t t-out="pmt_no"/></span>
                                        </td>
                                        <td class="tot-val">
                                            <t t-out="pmt.amount or 0.0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            <!-- only when the payment is not in the invoice currency -->
                                            <t t-if="pmt.currency_id and o.currency_id and pmt.currency_id != o.currency_id">
                                                <t t-out="pmt.currency_id.name"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                                <!-- Paid Amount row removed on purpose. -->
                            </table>
                    </td>
                </tr>
            </table>

            <!-- =================== FOOTER: BANK DETAILS + POLICY =================== -->
            <!-- Bank Details, full width: two label/value pairs per row. -->
            <table class="tbl-footer">
                <tr>
                    <td class="col-full">
                        <div class="info-card">
                            <div class="card-title">Bank Details / <span class="ar" dir="rtl">تفاصيل الحساب</span></div>
                            <t t-set="bank" t-value="company and (company.bank_ids or company.partner_id.bank_ids)[:1] or False"/>
                            <table class="tbl-kv tbl-kv-wide">
                                <tr>
                                    <td class="i-lbl">Bank Name:</td>
                                    <td class="i-val">
                                        <!-- Odoo 18: bank details are read from res.partner.bank
                                             (acc_number / acc_holder_name and the related bank_name / bank_bic). -->
                                        <t t-set="bank_name" t-value="bank and ((bank.bank_name if 'bank_name' in bank._fields else False) or (bank.bank_id.name if 'bank_id' in bank._fields and bank.bank_id else False)) or False"/>
                                        <t t-out="bank_name or 'Al Rajhi Bank'"/>
                                    </td>
                                    <td class="i-lbl">Account Name:</td>
                                    <td class="i-val">
                                        <t t-if="bank and 'acc_holder_name' in bank._fields and bank.acc_holder_name">
                                            <t t-out="bank.acc_holder_name"/>
                                        </t>
                                        <t t-elif="bank and 'holder_name' in bank._fields and bank.holder_name">
                                            <t t-out="bank.holder_name"/>
                                        </t>
                                        <t t-else="">
                                            <t t-out="company.name if company else ''"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="i-lbl" dir="rtl">اسم البنك:</td>
                                    <td class="i-val" dir="rtl">
                                        <t t-out="bank_name or 'مصرف الراجحي'"/>
                                    </td>
                                    <td class="i-lbl">Swift:</td>
                                    <td class="i-val">
                                        <t t-if="bank and 'bank_bic' in bank._fields and bank.bank_bic">
                                            <t t-out="bank.bank_bic"/>
                                        </t>
                                        <t t-elif="bank and 'bank_id' in bank._fields and bank.bank_id and bank.bank_id.bic">
                                            <t t-out="bank.bank_id.bic"/>
                                        </t>
                                        <t t-else="">RJHBSI</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="i-lbl">IBAN:</td>
                                    <td class="i-val mono" colspan="3">
                                        <t t-if="bank and 'acc_number' in bank._fields and bank.acc_number">
                                            <t t-out="bank.acc_number"/>
                                        </t>
                                        <t t-elif="bank and 'iban' in bank._fields and bank.iban">
                                            <t t-out="bank.iban"/>
                                        </t>
                                        <t t-elif="bank and 'account_number' in bank._fields and bank.account_number">
                                            <t t-out="bank.account_number"/>
                                        </t>
                                        <t t-else="">SA08 8000 0123 4567 8901 2345</t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Return &amp; Exchange Policy -->
            <div class="info-card footer-card policy-card">
                <div class="card-title">Return &amp; Exchange Policy / <span class="ar" dir="rtl">سياسة الاسترجاع والاستبدال</span></div>
                <ul class="policy-list">
                    <li>
                        <div class="policy-en"><span class="policy-dot">•</span> Customers may return or exchange any item within 7 days of purchase for a full refund or exchange, provided the item is unused and in its original condition.</div>
                        <div class="policy-ar" dir="rtl">يمكن للعميل إرجاع أو استبدال أي منتج خلال 7 أيام من تاريخ الشراء مع استرداد كامل المبلغ أو الاستبدال، بشرط أن يكون المنتج غير مستخدم وفي حالته الأصلية.</div>
                    </li>
                    <li>
                        <div class="policy-en"><span class="policy-dot">•</span> From day 8 up to 14 days after purchase, exchange only is accepted. No refunds will be issued during this period.</div>
                        <div class="policy-ar" dir="rtl">من اليوم الثامن وحتى 14 يوماً من تاريخ الشراء، يُقبل الاستبدال فقط ولا يتم استرداد المبلغ خلال هذه الفترة.</div>
                    </li>
                    <li>
                        <div class="policy-en"><span class="policy-dot">•</span> No returns or exchanges will be accepted after 14 days from the date of purchase.</div>
                        <div class="policy-ar" dir="rtl">لا يُقبل أي إرجاع أو استبدال بعد مرور 14 يوماً من تاريخ الشراء.</div>
                    </li>
                </ul>
            </div>

        </div>

